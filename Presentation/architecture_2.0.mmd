flowchart TD
    subgraph Data_Layer ["Data & Ingestion Layer"]
        TRAIN["🚆 🚋 🚂 Real-Time Train Movement Feed"]
        I1["📊 COA Real-Time Train Feed"]
        I2["⚙️ TMS / SMMS / TDMS Task APIs"]
        D1[("🪶 SQLite / PostgreSQL 🐘<br>(WAL Mode Enabled)")]
    end

    subgraph Backend_Layer ["FastAPI Service Layer"]
        API["⚡ FastAPI Async REST API"]
        SCORER["⚖️ Priority Scorer Engine"]
        COLLISION["🛡️ Spatial-Temporal Conflict Detector"]
    end

    subgraph Optimization_Engine ["Constraint Programming Engine"]
        CPSAT["🧩 Google OR-Tools CP-SAT Solver"]
        HC["🔒 Hard Constraints Validator<br>• NoOverlap (Machines & Tracks)<br>• Zero Train-Block Collision"]
        SC["✨ Soft Constraints & Objective<br>• Maximize High-Priority Completion<br>• Shadow Block Bonus"]
    end

    subgraph Presentation_Layer ["Presentation & Dispatch Layer"]
        UI1["🟠 D3.js Stringline (Marey) Chart"]
        UI2["📅 Weekly Block Calendar & Gantt"]
        UI3["📄 Auto-Generated Form 351 PTW Notice"]
    end

    %% Data Connections
    TRAIN -.-> I1
    I1 & I2 --> D1
    D1 --> API
    API --> SCORER
    API --> COLLISION
    API --> UI1
    API --> UI2
    API --> UI3

    %% Optimization Connections
    SCORER --> CPSAT
    COLLISION --> CPSAT
    CPSAT --> HC
    CPSAT --> SC
    HC --> CPSAT
    SC --> CPSAT
    CPSAT --> UI2
    CPSAT --> API

